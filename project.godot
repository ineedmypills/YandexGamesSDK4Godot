; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text editors.

config_version=5

[application]

config/name="Yandex Games SDK 4 Godot"
config/description="Yandex Games SDK plugin for Godot 4.x"
config/version="1.0.0"
run/main_scene="res://examples/demo.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

YandexGames="*res://addons/yandex_games/yandex_games.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/yandex_games/plugin.cfg")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
